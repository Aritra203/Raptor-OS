# ==============================================================================
# RaptorOS Environment Variables
# ==============================================================================
# Copy this file to .env for local bare-metal development, or configure via Docker Compose.
# NEVER commit .env to version control or hard-code secrets.

# Node environment: 'development', 'production', or 'test'
NODE_ENV=development

# Web application port
PORT=3000

# PostgreSQL connection string (Server-only, NEVER expose to browser)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL=postgresql://raptor:raptor_secret_pass@localhost:5432/raptoros?schema=public

# Session Secret (Server-only, minimum 32 characters)
SESSION_SECRET="raptoros_offline_session_secret_at_least_32_chars_long"
AUTH_COOKIE_NAME="raptoros_session"

# Optional Platform Settings
# Publicly accessible values must be prefixed with NEXT_PUBLIC_
NEXT_PUBLIC_APP_NAME="RaptorOS"
NEXT_PUBLIC_APP_VERSION="0.1.0"

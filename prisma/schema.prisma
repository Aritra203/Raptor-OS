generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// INFRASTRUCTURE
// ==============================================================================

/// Stores infrastructure-level configuration and initialization state.
model SystemSetting {
  key         String   @id
  value       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ==============================================================================
// ENUMS
// ==============================================================================

enum EventState {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  SUBMISSIONS_OPEN
  SUBMISSIONS_CLOSED
  JUDGING_OPEN
  JUDGING_CLOSED
  RESULTS_PUBLISHED
  ARCHIVED
}

enum EventRole {
  PARTICIPANT
  JUDGE
  ORGANIZER
  ADMIN
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TeamMemberRole {
  LEADER
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SubmissionState {
  DRAFT
  SUBMITTED
  LOCKED
  DISQUALIFIED
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXCUSED
}

enum RunStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ResultStatus {
  DRAFT
  FINALIZED
  PUBLISHED
}

enum CertificateType {
  PARTICIPATION
  WINNER
  FINALIST
  JUDGE
  ORGANIZER
  MENTOR
}

enum VotingEligibilityMode {
  ALL_AUTHENTICATED
  EVENT_PARTICIPANTS
}

enum CommentModerationStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

enum AbuseSignalStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTIONED
}

enum AbuseSignalSeverity {
  LOW
  MEDIUM
  HIGH
}

// ==============================================================================
// IDENTITY & USERS
// ==============================================================================

/// Global user identity with password authentication and event-scoped memberships.
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  avatarUrl       String?   @map("avatar_url")
  bio             String?
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Authentication sessions
  sessions        Session[]

  // Event memberships (event-scoped roles)
  eventMemberships   EventMembership[]
  createdTeams       Team[]               @relation("TeamCreator")
  teamMemberships    TeamMember[]
  submissionVersions SubmissionVersion[]  @relation("VersionAuthor")
  judgeAssignments   JudgeAssignment[]
  createdBatches     AssignmentBatch[]    @relation("BatchCreator")
  scores             Score[]              @relation("JudgeScores")
  normalizationRuns  NormalizationRun[]   @relation("NormalizationExecutor")
  judgeNormalizedScores NormalizedScore[] @relation("JudgeNormalizedScores")
  resultSnapshotsCreated ResultSnapshot[] @relation("ResultSnapshotCreator")
  votes              Vote[]
  comments           Comment[]
  commentsModerated  Comment[]            @relation("CommentModerator")
  abuseSignals       AbuseSignal[]
  abuseSignalsReviewed AbuseSignal[]     @relation("AbuseSignalReviewer")
  auditLogs          AuditLog[]           @relation("AuditActor")
  certificates       Certificate[]
  apiKeys            ApiKey[]

  @@index([email])
  @@map("users")
}

/// Cryptographically secure server-side session.
/// Tokens are hashed using SHA-256 before storage to protect raw tokens.
model Session {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  isRevoked    Boolean   @default(false) @map("is_revoked")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

// ==============================================================================
// EVENTS & LIFECYCLE
// ==============================================================================

/// Hackathon event with full state-machine lifecycle and date windows.
model Event {
  id                 String     @id @default(cuid())
  name               String
  slug               String     @unique
  description        String?
  location           String?
  isVirtual          Boolean    @default(true) @map("is_virtual")
  timezone           String     @default("UTC")
  state              EventState @default(DRAFT)
  registrationStart  DateTime?  @map("registration_start")
  registrationEnd    DateTime?  @map("registration_end")
  submissionsStart   DateTime?  @map("submissions_start")
  submissionsEnd     DateTime?  @map("submissions_end")
  judgingStart       DateTime?  @map("judging_start")
  judgingEnd         DateTime?  @map("judging_end")
  startsAt           DateTime?  @map("starts_at")
  endsAt             DateTime?  @map("ends_at")
  minTeamSize        Int        @default(1) @map("min_team_size")
  maxTeamSize        Int        @default(4) @map("max_team_size")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  // Event children (multi-event isolated)
  memberships        EventMembership[]
  tracks             Track[]
  prizes             Prize[]
  teams              Team[]
  submissions        Submission[]
  rubrics            Rubric[]
  judgeAssignments   JudgeAssignment[]
  assignmentBatches  AssignmentBatch[]
  scores             Score[]
  normalizationRuns  NormalizationRun[]
  results            Result[]
  resultSnapshots    ResultSnapshot[]
  votingConfig       VotingConfig?
  votes              Vote[]
  comments           Comment[]
  abuseSignals       AbuseSignal[]
  auditLogs          AuditLog[]
  certificates       Certificate[]
  apiKeys            ApiKey[]
  webhooks           Webhook[]
  webhookDeliveries  WebhookDelivery[]
  signedJudgeRecords SignedJudgeRecord[]

  @@index([slug])
  @@index([state])
  @@map("events")
}

/// Explicit event-scoped user roles and participation state.
model EventMembership {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  eventId   String           @map("event_id")
  role      EventRole        @default(PARTICIPANT)
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId, role])
  @@index([eventId, role])
  @@index([userId])
  @@map("event_memberships")
}

// ==============================================================================
// TRACKS & PRIZES
// ==============================================================================

/// Thematic competition track scoped strictly to an Event.
model Track {
  id          String       @id @default(cuid())
  eventId     String       @map("event_id")
  name        String
  slug        String
  description String?
  isActive    Boolean      @default(true) @map("is_active")
  order       Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  prizes      Prize[]
  teams       Team[]
  submissions Submission[]
  rubrics     Rubric[]
  results     Result[]
  projectResults ProjectResult[]

  @@unique([eventId, slug])
  @@index([eventId])
  @@map("tracks")
}

/// Award or bounty associated with an event and optionally restricted to a track.
model Prize {
  id          String        @id @default(cuid())
  eventId     String        @map("event_id")
  trackId     String?       @map("track_id")
  name        String
  description String?
  value       Decimal?      @db.Decimal(12, 2)
  order       Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  track       Track?        @relation(fields: [trackId], references: [id], onDelete: SetNull)
  results     Result[]
  projectResults ProjectResult[]
  certificates Certificate[]

  @@index([eventId])
  @@map("prizes")
}

// ==============================================================================
// TEAMS & INVITATIONS
// ==============================================================================

/// Competitive team scoped to a single event.
model Team {
  id          String           @id @default(cuid())
  eventId     String           @map("event_id")
  trackId     String?          @map("track_id")
  creatorId   String           @map("creator_id")
  name        String
  slug        String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  track       Track?           @relation(fields: [trackId], references: [id], onDelete: SetNull)
  creator     User             @relation("TeamCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  members     TeamMember[]
  invitations TeamInvitation[]
  submission  Submission?

  @@unique([eventId, slug])
  @@index([eventId])
  @@index([creatorId])
  @@map("teams")
}

/// Individual membership of a user inside a specific team.
model TeamMember {
  id        String         @id @default(cuid())
  teamId    String         @map("team_id")
  userId    String         @map("user_id")
  role      TeamMemberRole @default(MEMBER)
  joinedAt  DateTime       @default(now()) @map("joined_at")

  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

/// Invitation to join a team via email and secure token.
model TeamInvitation {
  id        String           @id @default(cuid())
  teamId    String           @map("team_id")
  email     String
  role      TeamMemberRole   @default(MEMBER)
  token     String           @unique
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime         @map("expires_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
  @@index([token])
  @@index([teamId])
  @@map("team_invitations")
}

// ==============================================================================
// SUBMISSIONS & VERSIONING
// ==============================================================================

/// Project submission submitted by a team in an event.
model Submission {
  id               String              @id @default(cuid())
  eventId          String              @map("event_id")
  teamId           String              @unique @map("team_id")
  trackId          String?             @map("track_id")
  title            String
  description      String
  repositoryUrl    String?             @map("repository_url")
  demoUrl          String?             @map("demo_url")
  deploymentUrl    String?             @map("deployment_url")
  documentationUrl String?             @map("documentation_url")
  customData       Json?               @map("custom_data")
  state            SubmissionState     @default(DRAFT)
  submittedAt      DateTime?           @map("submitted_at")
  lockedAt         DateTime?           @map("locked_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  event            Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team             Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  track            Track?              @relation(fields: [trackId], references: [id], onDelete: SetNull)
  versions         SubmissionVersion[]
  judgeAssignments JudgeAssignment[]
  scores           Score[]
  normalizedScores NormalizedScore[]
  result           Result?
  projectResults   ProjectResult[]
  votes            Vote[]
  comments         Comment[]
  abuseSignals     AbuseSignal[]
  signedJudgeRecords SignedJudgeRecord[]

  @@unique([eventId, teamId])
  @@index([eventId, state])
  @@index([trackId])
  @@map("submissions")
}

/// Immutable historical version snapshot of a submission.
model SubmissionVersion {
  id               String     @id @default(cuid())
  submissionId     String     @map("submission_id")
  versionNumber    Int        @map("version_number")
  title            String
  description      String
  repositoryUrl    String?    @map("repository_url")
  demoUrl          String?    @map("demo_url")
  deploymentUrl    String?    @map("deployment_url")
  documentationUrl String?    @map("documentation_url")
  customData       Json?      @map("custom_data")
  snapshotData     Json       @map("snapshot_data")
  submittedById    String     @map("submitted_by_id")
  createdAt        DateTime   @default(now()) @map("created_at")

  submission       Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submittedBy      User       @relation("VersionAuthor", fields: [submittedById], references: [id], onDelete: Restrict)

  @@unique([submissionId, versionNumber])
  @@index([submissionId])
  @@map("submission_versions")
}

// ==============================================================================
// RUBRIC & CRITERIA (VERSIONED)
// ==============================================================================

/// Rubric template for scoring submissions.
model Rubric {
  id          String          @id @default(cuid())
  eventId     String          @map("event_id")
  trackId     String?         @map("track_id")
  name        String
  description String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  event       Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  track       Track?          @relation(fields: [trackId], references: [id], onDelete: SetNull)
  versions    RubricVersion[]

  @@index([eventId])
  @@map("rubrics")
}

/// Versioned rubric definition to guarantee historical scores remain reproducible.
model RubricVersion {
  id            String            @id @default(cuid())
  rubricId      String            @map("rubric_id")
  versionNumber Int               @default(1) @map("version_number")
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at")

  rubric        Rubric            @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  criteria      RubricCriterion[]
  scores        Score[]

  @@unique([rubricId, versionNumber])
  @@index([rubricId])
  @@map("rubric_versions")
}

/// Individual criterion with weight and maximum score.
model RubricCriterion {
  id              String         @id @default(cuid())
  rubricVersionId String         @map("rubric_version_id")
  name            String
  description     String?
  weight          Decimal        @default(1.0) @db.Decimal(5, 2)
  maxScore        Decimal        @default(10.0) @db.Decimal(5, 2)
  order           Int            @default(0)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  rubricVersion   RubricVersion  @relation(fields: [rubricVersionId], references: [id], onDelete: Cascade)
  scoreItems      ScoreItem[]

  @@unique([rubricVersionId, name])
  @@index([rubricVersionId])
  @@map("rubric_criteria")
}

// ==============================================================================
// JUDGING, ASSIGNMENTS & SCORING
// ==============================================================================

/// Assignment of a Judge to evaluate a specific Submission in an Event.
model JudgeAssignment {
  id           String           @id @default(cuid())
  eventId      String           @map("event_id")
  judgeId      String           @map("judge_id")
  submissionId String           @map("submission_id")
  status       AssignmentStatus @default(PENDING)
  batchId      String?          @map("batch_id")
  assignedAt   DateTime         @default(now()) @map("assigned_at")
  completedAt  DateTime?        @map("completed_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judge        User             @relation(fields: [judgeId], references: [id], onDelete: Restrict)
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  batch        AssignmentBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  normalizedScores NormalizedScore[]

  @@unique([eventId, judgeId, submissionId])
  @@index([eventId, judgeId])
  @@index([submissionId])
  @@map("judge_assignments")
}

/// Tracked batch run of judge assignment algorithm with reproducibility metadata.
model AssignmentBatch {
  id              String            @id @default(cuid())
  eventId         String            @map("event_id")
  createdById     String            @map("created_by_id")
  algorithm       String            @default("DETERMINISTIC_BALANCED")
  targetCoverage  Int               @map("target_coverage")
  submissionCount Int               @map("submission_count")
  judgeCount      Int               @map("judge_count")
  assignmentCount Int               @map("assignment_count")
  parameters      Json?
  status          String            @default("COMPLETED")
  createdAt       DateTime          @default(now()) @map("created_at")

  event           Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy       User              @relation("BatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignments     JudgeAssignment[]

  @@index([eventId])
  @@map("assignment_batches")
}

/// Overall score evaluation submitted by a judge under a specific rubric version.
/// Raw scores are strictly immutable historical evidence.
model Score {
  id              String        @id @default(cuid())
  eventId         String        @map("event_id")
  judgeId         String        @map("judge_id")
  submissionId    String        @map("submission_id")
  rubricVersionId String        @map("rubric_version_id")
  feedback        String?
  isFinal         Boolean       @default(false) @map("is_final")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judge           User          @relation("JudgeScores", fields: [judgeId], references: [id], onDelete: Restrict)
  submission      Submission    @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  rubricVersion   RubricVersion @relation(fields: [rubricVersionId], references: [id], onDelete: Restrict)
  items           ScoreItem[]
  normalizedScores NormalizedScore[]

  @@unique([judgeId, submissionId, rubricVersionId])
  @@index([eventId, submissionId])
  @@index([judgeId])
  @@map("scores")
}

/// Score item for an individual criterion evaluated within a Score.
model ScoreItem {
  id          String          @id @default(cuid())
  scoreId     String          @map("score_id")
  criterionId String          @map("criterion_id")
  rawScore    Decimal         @db.Decimal(5, 2)
  feedback    String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  score       Score           @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  criterion   RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@unique([scoreId, criterionId])
  @@index([scoreId])
  @@map("score_items")
}

// ==============================================================================
// NORMALIZATION & RESULTS
// ==============================================================================

/// Reproducible batch run of score normalization algorithm (e.g., Z-Score, Min-Max).
model NormalizationRun {
  id               String            @id @default(cuid())
  eventId          String            @map("event_id")
  method           String            // e.g., "Z_SCORE", "MIN_MAX"
  version          Int               @default(1)
  inputScoreCount  Int               @default(0) @map("input_score_count")
  parameters       Json
  metadata         Json?
  status           RunStatus         @default(COMPLETED)
  executedById     String            @map("executed_by_id")
  createdAt        DateTime          @default(now()) @map("created_at")

  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  executedBy       User              @relation("NormalizationExecutor", fields: [executedById], references: [id], onDelete: Restrict)
  normalizedScores NormalizedScore[]
  resultSnapshots  ResultSnapshot[]

  @@unique([eventId, version])
  @@index([eventId])
  @@map("normalization_runs")
}

/// Computed normalized score produced by a NormalizationRun.
/// Never overwrites raw score.
model NormalizedScore {
  id                 String           @id @default(cuid())
  normalizationRunId String           @map("normalization_run_id")
  submissionId       String           @map("submission_id")
  judgeId            String?          @map("judge_id")
  assignmentId       String?          @map("assignment_id")
  scoreId            String?          @map("score_id")
  rawScore           Decimal?         @db.Decimal(7, 4) @map("raw_score")
  normalizedValue    Decimal          @db.Decimal(7, 4)
  zScore             Float?           @map("z_score")
  percentile         Float?
  calibrationData    Json?            @map("calibration_data")
  createdAt          DateTime         @default(now()) @map("created_at")

  normalizationRun   NormalizationRun @relation(fields: [normalizationRunId], references: [id], onDelete: Cascade)
  submission         Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  judge              User?            @relation("JudgeNormalizedScores", fields: [judgeId], references: [id], onDelete: SetNull)
  assignment         JudgeAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  score              Score?           @relation(fields: [scoreId], references: [id], onDelete: SetNull)

  @@index([normalizationRunId])
  @@index([submissionId])
  @@index([judgeId])
  @@map("normalized_scores")
}

/// Final published results and placements for an event.
model Result {
  id                 String     @id @default(cuid())
  eventId            String     @map("event_id")
  submissionId       String     @unique @map("submission_id")
  trackId            String?    @map("track_id")
  prizeId            String?    @map("prize_id")
  rank               Int?
  rawAggregateScore  Decimal    @db.Decimal(7, 4) @map("raw_aggregate_score")
  normalizedScore    Decimal?   @db.Decimal(7, 4) @map("normalized_score")
  finalScore         Decimal    @db.Decimal(7, 4) @map("final_score")
  isPublished        Boolean    @default(false) @map("is_published")
  publishedAt        DateTime?  @map("published_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  event              Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submission         Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  track              Track?     @relation(fields: [trackId], references: [id], onDelete: SetNull)
  prize              Prize?     @relation(fields: [prizeId], references: [id], onDelete: SetNull)
  certificates       Certificate[]

  @@unique([eventId, submissionId])
  @@index([eventId, rank])
  @@index([isPublished])
  @@map("results")
}

/// Durable, versioned result snapshot with explicit lifecycle (DRAFT -> FINALIZED -> PUBLISHED).
model ResultSnapshot {
  id                 String            @id @default(cuid())
  eventId            String            @map("event_id")
  normalizationRunId String?           @map("normalization_run_id")
  version            Int               @default(1)
  status             ResultStatus      @default(DRAFT)
  name               String?
  notes              String?
  createdById        String            @map("created_by_id")
  finalizedAt        DateTime?         @map("finalized_at")
  publishedAt        DateTime?         @map("published_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  event              Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  normalizationRun   NormalizationRun? @relation(fields: [normalizationRunId], references: [id], onDelete: SetNull)
  createdBy          User              @relation("ResultSnapshotCreator", fields: [createdById], references: [id], onDelete: Restrict)
  results            ProjectResult[]
  signedJudgeRecords SignedJudgeRecord[]

  @@unique([eventId, version])
  @@index([eventId, status])
  @@map("result_snapshots")
}

/// Itemized project ranking entry inside a ResultSnapshot.
model ProjectResult {
  id                 String          @id @default(cuid())
  snapshotId         String          @map("snapshot_id")
  submissionId       String          @map("submission_id")
  trackId            String?         @map("track_id")
  prizeId            String?         @map("prize_id")
  rank               Int
  trackRank          Int?            @map("track_rank")
  rawAggregateScore  Decimal         @db.Decimal(7, 4) @map("raw_aggregate_score")
  normalizedScore    Decimal?        @db.Decimal(7, 4) @map("normalized_score")
  finalScore         Decimal         @db.Decimal(7, 4) @map("final_score")
  scoreCount         Int             @default(0) @map("score_count")
  metadata           Json?
  createdAt          DateTime        @default(now()) @map("created_at")

  snapshot           ResultSnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  submission         Submission      @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  track              Track?          @relation(fields: [trackId], references: [id], onDelete: SetNull)
  prize              Prize?          @relation(fields: [prizeId], references: [id], onDelete: SetNull)

  @@unique([snapshotId, submissionId])
  @@index([snapshotId, rank])
  @@map("project_results")
}

// ==============================================================================
// COMMUNITY VOTING & COMMENTS
// ==============================================================================

/// Event-level community voting configuration and governance.
model VotingConfig {
  id                    String                @id @default(cuid())
  eventId               String                @unique @map("event_id")
  isEnabled             Boolean               @default(false) @map("is_enabled")
  votingStart           DateTime?             @map("voting_start")
  votingEnd             DateTime?             @map("voting_end")
  eligibilityMode       VotingEligibilityMode @default(EVENT_PARTICIPANTS) @map("eligibility_mode")
  allowParticipantVotes Boolean               @default(true) @map("allow_participant_votes")
  allowJudgeVotes       Boolean               @default(true) @map("allow_judge_votes")
  allowOrganizerVotes   Boolean               @default(false) @map("allow_organizer_votes")
  allowSelfVoting       Boolean               @default(false) @map("allow_self_voting")
  publicVoteCounts      Boolean               @default(false) @map("public_vote_counts")
  resultsPublished      Boolean               @default(false) @map("results_published")
  resultsPublishedAt    DateTime?             @map("results_published_at")
  randomizeGalleryOrder Boolean               @default(false) @map("randomize_gallery_order")
  galleryRandomSeed     Int?                  @default(1337) @map("gallery_random_seed")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  event                 Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("voting_configs")
}

/// Community or peer vote cast for a submission.
model Vote {
  id              String     @id @default(cuid())
  eventId         String     @map("event_id")
  submissionId    String     @map("submission_id")
  voterId         String     @map("voter_id")
  votingSessionId String?    @map("voting_session_id")
  createdAt       DateTime   @default(now()) @map("created_at")

  event           Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submission      Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  voter           User       @relation(fields: [voterId], references: [id], onDelete: Restrict)

  @@unique([eventId, voterId, submissionId])
  @@index([eventId, submissionId])
  @@index([voterId])
  @@map("votes")
}

/// Discussion comment on a project submission with moderation status.
model Comment {
  id               String                  @id @default(cuid())
  eventId          String                  @map("event_id")
  submissionId     String                  @map("submission_id")
  userId           String                  @map("user_id")
  content          String                  @db.Text
  moderationStatus CommentModerationStatus @default(PUBLISHED) @map("moderation_status")
  moderatedById    String?                 @map("moderated_by_id")
  moderatedAt      DateTime?               @map("moderated_at")
  isDeleted        Boolean                 @default(false) @map("is_deleted")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  event            Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submission       Submission              @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user             User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  moderatedBy      User?                   @relation("CommentModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@index([submissionId, moderationStatus, createdAt])
  @@index([eventId, moderationStatus])
  @@map("comments")
}

/// Flagged abuse or suspicious activity signal for organizer review.
model AbuseSignal {
  id           String              @id @default(cuid())
  eventId      String              @map("event_id")
  submissionId String?             @map("submission_id")
  userId       String?             @map("user_id")
  signalType   String              @map("signal_type") // e.g. "HIGH_VELOCITY", "REPEATED_FAILED_ATTEMPTS", "SELF_VOTE_ATTEMPT", "EXCESSIVE_FREQUENCY"
  severity     AbuseSignalSeverity @default(MEDIUM)
  description  String
  metadata     Json?
  status       AbuseSignalStatus   @default(OPEN)
  reviewNotes  String?             @map("review_notes")
  reviewedById String?             @map("reviewed_by_id")
  reviewedAt   DateTime?           @map("reviewed_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  event        Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submission   Submission?         @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  reviewedBy   User?               @relation("AbuseSignalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@index([userId])
  @@index([submissionId])
  @@map("abuse_signals")
}

// ==============================================================================
// AUDIT LOG & CERTIFICATES
// ==============================================================================

/// Append-only tamper-evident audit log for judging, lifecycle, and administrative events.
model AuditLog {
  id         String   @id @default(cuid())
  eventId    String?  @map("event_id")
  actorId    String?  @map("actor_id")
  action     String   // e.g. "EVENT_STATE_CHANGED", "SCORE_SUBMITTED", "NORMALIZATION_RUN"
  entityType String   @map("entity_type") // e.g. "Event", "Score", "Submission"
  entityId   String   @map("entity_id")
  metadata   Json?
  timestamp  DateTime @default(now())

  event      Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([eventId, timestamp])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

/// Verifiable public certificate issued to participants, winners, and judges.
model Certificate {
  id               String          @id @default(cuid())
  eventId          String          @map("event_id")
  recipientId      String          @map("recipient_id")
  type             CertificateType @default(PARTICIPATION)
  title            String
  description      String?
  verificationId   String          @unique @map("verification_id")
  resultId         String?         @map("result_id")
  prizeId          String?         @map("prize_id")
  isRevoked        Boolean         @default(false) @map("is_revoked")
  revocationReason String?         @map("revocation_reason")
  metadata         Json?
  issuedAt         DateTime        @default(now()) @map("issued_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  event            Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipient        User            @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  result           Result?         @relation(fields: [resultId], references: [id], onDelete: SetNull)
  prize            Prize?          @relation(fields: [prizeId], references: [id], onDelete: SetNull)

  @@index([verificationId])
  @@index([eventId, recipientId])
  @@map("certificates")
}

// ==============================================================================
// PHASE 9: API KEYS, WEBHOOKS & SIGNED JUDGE RECORDS
// ==============================================================================

/// Cryptographically random programmatic API keys for headless/external clients.
/// Only SHA-256 hashes are persisted; raw keys are revealed only at creation.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  eventId    String?   @map("event_id")
  name       String
  keyPrefix  String    @map("key_prefix")
  keyHash    String    @unique @map("key_hash")
  scopes     Json?
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  isRevoked  Boolean   @default(false) @map("is_revoked")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
  @@map("api_keys")
}

/// Event-scoped webhook subscription with HMAC-SHA256 signature verification.
model Webhook {
  id         String            @id @default(cuid())
  eventId    String            @map("event_id")
  name       String
  url        String
  secret     String
  events     Json
  isActive   Boolean           @default(true) @map("is_active")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  event      Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([eventId, isActive])
  @@map("webhooks")
}

/// Durable delivery log and bounded retry queue for dispatched webhook events.
model WebhookDelivery {
  id            String    @id @default(cuid())
  webhookId     String    @map("webhook_id")
  eventId       String    @map("event_id")
  eventType     String    @map("event_type")
  deliveryId    String    @unique @map("delivery_id")
  payload       Json
  status        String    @default("PENDING")
  attemptCount  Int       @default(0) @map("attempt_count")
  statusCode    Int?      @map("status_code")
  responseBody  String?   @map("response_body") @db.Text
  nextRetryAt   DateTime? @map("next_retry_at")
  failureReason String?   @map("failure_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  deliveredAt   DateTime? @map("delivered_at")

  webhook       Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([webhookId, status])
  @@index([eventId, eventType])
  @@index([deliveryId])
  @@map("webhook_deliveries")
}

/// Cryptographically signed canonical judge evaluation record for public integrity verification.
model SignedJudgeRecord {
  id             String          @id @default(cuid())
  eventId        String          @map("event_id")
  submissionId   String          @map("submission_id")
  snapshotId     String?         @map("snapshot_id")
  judgePseudonym String          @map("judge_pseudonym")
  canonicalData  Json            @map("canonical_data")
  recordHash     String          @map("record_hash")
  signature      String          @db.Text
  algorithm      String          @default("Ed25519")
  createdAt      DateTime        @default(now()) @map("created_at")

  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submission     Submission      @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  snapshot       ResultSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@index([eventId, submissionId])
  @@index([recordHash])
  @@map("signed_judge_records")
}
